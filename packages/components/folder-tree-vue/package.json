{
  "name": "@wgl-m/folder-tree-vue",
  "version": "1.0.0",
  "description": "Vue 3 folder tree component based on @wgl-m/folder-tree core",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": {
    "name": "Mr.Wang",
    "email": "17600980516@163.com",
    "url": "https://github.com/wangguanl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangguanl/wgl-monorepo",
    "directory": "packages/components/folder-tree-vue"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --declarationMap --outDir dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@wgl-m/folder-tree": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/server-renderer": "^3.5.42",
    "typescript": "^5.7.2",
    "vite": "^8.1.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.33",
    "vue-tsc": "^3.3.2"
  }
}
