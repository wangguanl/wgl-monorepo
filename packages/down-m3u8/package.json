{
  "name": "@wgl-m/down-m3u8",
  "version": "0.1.0",
  "description": "M3U8 视频下载：ffmpeg 转封装（-c copy）保存为 mp4，支持单文件与多视频（由 tool__down-m3u8 迁移而来）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "down-m3u8": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "author": {
    "name": "Mr.Wang",
    "email": "17600980516@163.com",
    "url": "https://github.com/wangguanl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangguanl/wgl-monorepo",
    "directory": "packages/down-m3u8"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}